@@ -0,0 +1,90 @@
+use codex_code_mode::FunctionCallOutputContentItem;
+
+pub(super) const INITIAL_BACKOFF_MS: u64 = 30_000;
+pub(super) const MAX_BACKOFF_MS: u64 = 600_000;
+const MAX_BUFFERED_OUTPUT_BYTES: usize = 256 * 1024;
+const MAX_BUFFERED_OUTPUT_ITEMS: usize = 256;
+const OUTPUT_TRUNCATED_MESSAGE: &str =
+    "Some intermediate task output was omitted because it exceeded the local buffer limit.";
+
+/// Tracks the next observation interval for one code-mode cell.
+pub(super) struct WaitBackoff {
+    next_yield_time_ms: u64,
+    buffered_content_items: Vec<FunctionCallOutputContentItem>,
+    buffered_output_bytes: usize,
+    buffered_output_truncated: bool,
+}
+
+impl WaitBackoff {
+    pub(super) fn new() -> Self {
+        Self {
+            next_yield_time_ms: INITIAL_BACKOFF_MS,
+            buffered_content_items: Vec::new(),
+            buffered_output_bytes: 0,
+            buffered_output_truncated: false,
+        }
+    }
+
+    pub(super) fn next_yield_time_ms(&self) -> u64 {
+        self.next_yield_time_ms
+    }
+
+    pub(super) fn record_empty_yield(&mut self) {
+        self.next_yield_time_ms = self
+            .next_yield_time_ms
+            .saturating_mul(2)
+            .min(MAX_BACKOFF_MS);
+    }
+
+    pub(super) fn record_activity(&mut self, content_items: Vec<FunctionCallOutputContentItem>) {
+        self.next_yield_time_ms = INITIAL_BACKOFF_MS;
+        for content_item in content_items {
+            let item_bytes = content_item_bytes(&content_item);
+            if self.buffered_content_items.len() >= MAX_BUFFERED_OUTPUT_ITEMS
+                || self.buffered_output_bytes.saturating_add(item_bytes) > MAX_BUFFERED_OUTPUT_BYTES
+            {
+                self.buffered_output_truncated = true;
+                continue;
+            }
+            self.buffered_output_bytes = self.buffered_output_bytes.saturating_add(item_bytes);
+            self.buffered_content_items.push(content_item);
+        }
+    }
+
+    pub(super) fn take_content_items(
+        &mut self,
+        current: Vec<FunctionCallOutputContentItem>,
+        idle_message: Option<&str>,
+    ) -> Vec<FunctionCallOutputContentItem> {
+        let mut content_items = std::mem::take(&mut self.buffered_content_items);
+        content_items.extend(current);
+        if self.buffered_output_truncated {
+            content_items.push(FunctionCallOutputContentItem::InputText {
+                text: OUTPUT_TRUNCATED_MESSAGE.to_string(),
+            });
+        }
+        if let Some(idle_message) = idle_message {
+            content_items.push(FunctionCallOutputContentItem::InputText {
+                text: idle_message.to_string(),
+            });
+        }
+        self.buffered_output_bytes = 0;
+        self.buffered_output_truncated = false;
+        content_items
+    }
+}
+
+fn content_item_bytes(content_item: &FunctionCallOutputContentItem) -> usize {
+    match content_item {
+        FunctionCallOutputContentItem::InputText { text }
+        | FunctionCallOutputContentItem::InputImage {
+            image_url: text,
+            detail: _,
+        }
+        | FunctionCallOutputContentItem::InputAudio { audio_url: text } => text.len(),
+    }
+}
+
