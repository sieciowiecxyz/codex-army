+use super::INITIAL_BACKOFF_MS;
+use super::MAX_BACKOFF_MS;
+use super::WaitBackoff;
+use codex_code_mode::FunctionCallOutputContentItem;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn wait_backoff_doubles_until_the_ten_minute_ceiling() {
+    let mut backoff = WaitBackoff::new();
+    let mut observed = Vec::new();
+
+    for _ in 0..10 {
+        let next = backoff.next_yield_time_ms();
+        observed.push(next);
+        backoff.record_empty_yield();
+    }
+
+    assert_eq!(
+        observed,
+        vec![
+            INITIAL_BACKOFF_MS,
+            60_000,
+            120_000,
+            240_000,
+            480_000,
+            MAX_BACKOFF_MS,
+            MAX_BACKOFF_MS,
+            MAX_BACKOFF_MS,
+            MAX_BACKOFF_MS,
+            MAX_BACKOFF_MS,
+        ]
+    );
+}
+
+#[test]
+fn activity_resets_the_schedule_and_buffers_output() {
+    let mut backoff = WaitBackoff::new();
+    backoff.record_empty_yield();
+    backoff.record_activity(vec![FunctionCallOutputContentItem::InputText {
+        text: "progress".to_string(),
+    }]);
+
+    assert_eq!(backoff.next_yield_time_ms(), INITIAL_BACKOFF_MS);
+    assert_eq!(
+        backoff.take_content_items(Vec::new(), None),
+        vec![FunctionCallOutputContentItem::InputText {
+            text: "progress".to_string(),
+        }]
+    );
+}
+
+#[test]
+fn idle_cycle_includes_a_model_visible_message() {
+    let mut backoff = WaitBackoff::new();
+    for _ in 0..5 {
+        backoff.record_empty_yield();
+    }
+
+    assert_eq!(
+        backoff.take_content_items(Vec::new(), Some("still running")),
+        vec![FunctionCallOutputContentItem::InputText {
+            text: "still running".to_string(),
+        }]
+    );
+    assert_eq!(backoff.next_yield_time_ms(), MAX_BACKOFF_MS);
+}
